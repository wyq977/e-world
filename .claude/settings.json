{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-sources.sh"
          }
        ]
      },
      {
        "matcher": "mcp__zotero__zotero_(add|update|delete|create|batch|attach|manage|set|authorize)_.*",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Blocked: Zotero is read-only for the agent (AGENTS.md). Ask the human to do this in Zotero.' >&2; exit 2"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-zotero.sh"
          }
        ]
      }
    ]
  }
}
